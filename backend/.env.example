# ─── ShopSphere backend configuration ─────────────────────────────────────────
# Copy to .env and fill in values from the Aiven console. NEVER commit .env.

NODE_ENV=production
PORT=4000
# Comma-separated list of allowed storefront origins (CORS)
FRONTEND_URL=https://your-shopsphere.lovable.app,http://localhost:8080

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Aiven PostgreSQL ─────────────────────────────────────────────────────────
# Service URI from the Aiven console (Overview → Service URI). sslmode=require.
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require
# Optional: contents of the PostgreSQL CA certificate (ca.pem) for full verification.
# Use \n for newlines, or set DATABASE_CA_CERT_PATH instead.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

# ─── Aiven Apache Kafka ───────────────────────────────────────────────────────
# Comma-separated bootstrap servers (Overview → Service URI, SASL port when using SASL)
KAFKA_BROKERS=kafka-xxxx.aivencloud.com:12346
# Authentication: "sasl" (SCRAM-SHA-256, recommended) or "mtls" (client certificate)
KAFKA_AUTH=sasl
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
# CA certificate (ca.pem) — inline with \n newlines, or a path
KAFKA_CA_CERT=
KAFKA_CA_CERT_PATH=
# Only for KAFKA_AUTH=mtls
KAFKA_ACCESS_CERT=
KAFKA_ACCESS_KEY=
KAFKA_CLIENT_ID=shopsphere
KAFKA_TOPIC_ORDER_PLACED=order-placed
KAFKA_TOPIC_INVENTORY_UPDATED=inventory-updated

# ─── Aiven OpenSearch ─────────────────────────────────────────────────────────
OPENSEARCH_URL=https://os-xxxx.aivencloud.com:12347
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=shopsphere_products

# ─── Workers ─────────────────────────────────────────────────────────────────
# true = run outbox publisher + both Kafka consumers inside the API process
# (handy on a single Render/Railway instance). false = run `npm run worker` separately.
RUN_WORKERS=true
OUTBOX_POLL_MS=1000

# ─── Seed accounts (used only by `npm run seed`) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@shopsphere.in
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@shopsphere.in
SEED_CUSTOMER_PASSWORD=
